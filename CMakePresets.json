{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base", "hidden": true, "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "REXSDK_DIR": "${sourceDir}/third_party/rexglue-sdk",
        "CASTLE_GAME_DATA_ROOT": "${sourceDir}/game",
        "REXGLUE_USE_VULKAN": "ON"
      }
    },
    {
      "name": "host-codegen", "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "android-release", "inherits": "base",
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a", "ANDROID_PLATFORM": "android-33",
        "ANDROID_STL": "c++_shared",
        "CMAKE_C_FLAGS": "-O3 -march=armv8-a", "CMAKE_CXX_FLAGS": "-O3 -march=armv8-a"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-codegen", "configurePreset": "host-codegen" },
    { "name": "android-release", "configurePreset": "android-release" }
  ]
}
